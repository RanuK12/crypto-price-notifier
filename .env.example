# Configuración del bot Crypto Price Notifier
# Para obtener el token de Telegram:
# 1. Abre Telegram y busca @BotFather
# 2. Ejecuta /newbot y sigue las instrucciones
# 3. Copia el token generado y setealo aquí
TELEGRAM_BOT_TOKEN='TU_TOKEN_DE_TELEGRAM'

# Para obtener el chat ID:
# 1. Abre Telegram y busca @userinfobot
# 2. Enviá un mensaje a @userinfobot
# 3. Copia el ID que te devuelve y setealo aquí
TELEGRAM_CHAT_ID='TU_CHAT_ID'

# Intervalo de verificación en segundos (ejemplo: 300 = 5 minutos)
CHECK_INTERVAL=300

# Monitorear monedas (ejemplo: bitcoin, ethereum, solana)
COINS='bitcoin,ethereum,solana'

# Umbrales para alertas (formato: moneda:arriba|abajo:precio)
# Ejemplo: bitcoin:arriba:100000, ethereum:abajo:3000
THRESHOLDS='bitcoin:above:100000,ethereum:below:3000,solana:above:200'