# Crypto Price Notifier - Environment Configuration

# Telegram Bot Token
# Get your token from @BotFather on Telegram.
# Example: TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID
# Your personal chat ID where notifications will be sent.
# Example: TELEGRAM_CHAT_ID=987654321
TELEGRAM_CHAT_ID=

# Check interval in seconds
# How often the bot checks prices (default: 300 seconds / 5 minutes)
CHECK_INTERVAL=300

# Coins to monitor
# List of cryptocurrencies to track (comma-separated)
# Example: COINS=bitcoin,ethereum,solana,cardano
COINS=bitcoin,ethereum,solana

# Thresholds for notifications
# Format: coin:above|below:value (comma-separated)
# Example: THRESHOLDS=bitcoin:above:50000,ethereum:below:3000
THRESHOLDS=bitcoin:above:100000,ethereum:below:3000,solana:above:200